<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ikinciFragment">

    <AutoCompleteTextView
        android:id="@+id/tarlaEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="21dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/edit_text_custom"
        android:backgroundTint="@color/editTextGray"
        android:ems="10"
        android:fontFamily="@font/sen"
        android:hint="Tarlayı seçiniz"
        android:inputType="text"
        android:padding="15dp"
        android:textAlignment="center"
        android:textColor="@color/editTextColor"
        android:textColorHint="@color/editTextColor"
        app:layout_constraintEnd_toStartOf="@+id/kgEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3"
        app:layout_constraintWidth_percent="0.45" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="37dp"
        android:fontFamily="@font/sen"
        android:text="Tarla ismi"
        android:textColor="@color/textViewColor"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="17dp"
        android:fontFamily="@font/sen"
        android:text="Kg"
        android:textColor="@color/textViewColor"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/kgEditText"
        app:layout_constraintStart_toStartOf="@+id/kgEditText" />

    <EditText
        android:id="@+id/kgEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/edit_text_custom"
        android:backgroundTint="@color/editTextGray"
        android:ems="10"
        android:hint="Kg giriniz"
        android:inputType="number|numberDecimal"
        android:padding="15dp"
        android:textAlignment="center"
        android:textColorHint="@color/editTextColor"
        app:layout_constraintBaseline_toBaselineOf="@+id/tarlaEditText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tarlaEditText"
        app:layout_constraintWidth_percent="0.45" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/sen"
        android:text="Tarih"
        android:textAlignment="viewStart"
        android:textColor="@color/textViewColor"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/tarihEditText"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tarihEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_custom"
        android:backgroundTint="@color/editTextGray"
        android:ems="10"
        android:fontFamily="@font/sen"
        android:padding="15dp"
        android:text="Tarih seçiniz"
        android:textAlignment="center"
        android:textColor="@color/editTextColor"
        android:textColorHint="@color/editTextColor"
        android:textSize="20sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/surumEditText"
        app:layout_constraintEnd_toStartOf="@+id/surumEditText"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.45" />

    <EditText
        android:id="@+id/surumEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="201dp"
        android:background="@drawable/edit_text_custom"
        android:backgroundTint="@color/editTextGray"
        android:fontFamily="@font/sen"
        android:hint="Sürüm giriniz"
        android:inputType="number"
        android:padding="15dp"
        android:textAlignment="center"
        android:textColorHint="@color/editTextColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tarihEditText"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.45" />

    <Button
        android:id="@+id/kaydetButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:backgroundTint="@color/textViewColor"
        android:fontFamily="@font/sen"
        android:text="Kaydet"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tarihEditText" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/sen"
        android:text="Sürüm"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/surumEditText"
        app:layout_constraintStart_toStartOf="@+id/surumEditText" />

    <Button
        android:id="@+id/silButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="59dp"
        android:text="Button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/kaydetButton" />

</androidx.constraintlayout.widget.ConstraintLayout>