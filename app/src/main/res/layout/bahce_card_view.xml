<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:orientation="vertical"
    android:layout_gravity="center_horizontal"
    >


    <androidx.cardview.widget.CardView
        android:id="@+id/BahceCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@color/white"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:stateListAnimator="@anim/animation"
        app:cardCornerRadius="15dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="10dp"
            android:paddingBottom="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/BahceIsmiTextView"
            app:layout_constraintTop_toBottomOf="@+id/BahceIsmiTextView">

            <TextView
                android:id="@+id/BahceIsmiTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:text="2025"
                android:textAlignment="viewStart"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/textView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintWidth_percent="0.4" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:text="Toplam miktar"
                android:textColor="@color/recyclerViewGray"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/BahceIsmiTextView"
                app:layout_constraintWidth_percent="0.28" />

            <TextView
                android:id="@+id/BahceToplamKgTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="9999kg"
                android:textColor="@color/recyclerViewBlue"
                app:layout_constraintStart_toEndOf="@+id/textView"
                app:layout_constraintTop_toTopOf="@+id/textView"
                app:layout_constraintWidth_percent="0.2" />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="83dp"
                android:layout_height="19dp"
                android:text="Toplam gelir"
                android:textColor="@color/recyclerViewGray"
                app:layout_constraintEnd_toStartOf="@+id/BahceToplamGelirTextView"
                app:layout_constraintTop_toTopOf="@+id/BahceToplamKgTextView"
                app:layout_constraintWidth_percent="0.28" />

            <TextView
                android:id="@+id/BahceToplamGelirTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:text="200000"
                android:textColor="@color/recyclerViewBlue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textView11"
                app:layout_constraintWidth_percent="0.2" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


</LinearLayout>