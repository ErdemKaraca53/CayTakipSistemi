<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#E1FFBB" />
                    <padding android:right="15dp"
                        android:left="15dp" />
                    <corners android:radius="4dp" />
                    <stroke android:width="1px" android:color="@color/spinnerColor"/>
                </shape>
            </item>

            <item

                android:drawable="@drawable/keyboard_arrow_down"
                android:gravity="end" />
        </layer-list>
    </item>
</selector>
