<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main_nav"
    app:startDestination="@id/new_design">

    <fragment
        android:id="@+id/birinciFragment"
        android:name="com.erdem.designexample.design.birinciFragment"
        android:label="fragment_birinci"
        tools:layout="@layout/fragment_birinci" >
        <argument
            android:name="year"
            app:argType="integer"
            android:defaultValue="3" />
        <argument
            android:name="season"
            app:argType="integer"
            android:defaultValue="3" />
        <action
            android:id="@+id/action_birinciFragment_to_surumFragment"
            app:destination="@id/surumFragment" />
    </fragment>
    <fragment
        android:id="@+id/ikinciFragment"
        android:name="com.erdem.designexample.design.ikinciFragment"
        android:label="fragment_ikinici"
        tools:layout="@layout/fragment_ikinici" >
        <argument
            android:name="bahce"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/new_design"
        android:name="com.erdem.designexample.design.new_design"
        android:label="fragment_new_design"
        tools:layout="@layout/fragment_new_design" />
    <fragment
        android:id="@+id/surumFragment"
        android:name="com.erdem.designexample.design.SurumFragment"
        android:label="fragment_surum"
        tools:layout="@layout/fragment_surum" >
        <action
            android:id="@+id/action_surumFragment_to_bahceFragment"
            app:destination="@id/bahceFragment" />
    </fragment>
    <fragment
        android:id="@+id/bahceFragment"
        android:name="com.erdem.designexample.design.BahceFragment"
        android:label="fragment_bahce"
        tools:layout="@layout/fragment_bahce" />
</navigation>